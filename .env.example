# Copy to .env and fill in the credentials for the AI provider(s) you want to use.
# If left unset, the pipeline defaults to headless Claude Code (`claude -p`) when available.

# --- Provider API Keys ---
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENROUTER_API_KEY=sk-or-...
# GEMINI_API_KEY=...

# --- Primary AI (descriptions, drawings, form labels, org charts, titles) ---
# Providers: auto | claude-cli | anthropic | openai | openrouter | ollama | gemini | none
# A11Y_AI_PROVIDER=auto
# A11Y_AI_MODEL=claude-haiku-5-5
# A11Y_AI_BASE_URL=

# --- Optional Independent Eval AI (Stage 4 content review & Stage 5 alt-text sanity) ---
# Leave commented to use the same model as Primary AI, or choose a different model/provider:
# A11Y_EVAL_PROVIDER=openai
# A11Y_EVAL_MODEL=gpt-4.1
# A11Y_EVAL_BASE_URL=

# --- Optional Local Tool Overrides ---
# A11Y_VERAPDF=/path/to/verapdf
# A11Y_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
